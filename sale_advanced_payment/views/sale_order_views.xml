<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_advance" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.advance</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook/page[@name='other_information']" position="inside">
                <group>
                    <field name="advance_payment"/>
                    <button name="action_create_advance_entry" type="object" string="Create Advance Entry" class="oe_highlight"/>
                </group>
            </xpath>
        </field>
    </record>   
</odoo>